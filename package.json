{
  "name": "pdr-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @pdr/api test:unit && pnpm --filter @pdr/shared test",
    "test:integration": "pnpm --filter @pdr/api test:integration",
    "db:migrate": "pnpm --filter @pdr/api db:migrate",
    "db:deploy": "pnpm --filter @pdr/api db:deploy",
    "db:seed": "pnpm --filter @pdr/api db:seed",
    "db:reset": "pnpm --filter @pdr/api db:reset",
    "dev": "pnpm --parallel --filter @pdr/api --filter @pdr/miniapp --filter @pdr/admin dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.14.0",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
