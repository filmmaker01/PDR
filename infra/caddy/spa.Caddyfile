:80 {
	root * /srv
	encode gzip zstd
	# Mini App открывается внутри WebView Telegram, поэтому frame-ancestors
	# разрешает Telegram, а X-Frame-Options не ставится вовсе.
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org tg:; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss:; frame-src https://kinescope.io https://*.kinescope.io"
	}
	@static path *.js *.css *.woff2 *.png *.jpg *.svg *.webp
	header @static Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
