# ─────────────────────────────────────────────────────────────────────────────
# Конфигурация API. Значения проверяются при старте (apps/api/src/config).
#
# Пометки:
#   [обяз.]   без него приложение не стартует
#   [ключ]    внешний сервис: значение выдаёт провайдер, см. docs/13-staging.md
#   [демо]    можно оставить как есть для локального запуска и staging-демо
# ─────────────────────────────────────────────────────────────────────────────

# ── Общие ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# local | test | staging | production
APP_ENV=local
PORT=3000
# [обяз.] Публичные адреса: попадают в ссылки, CORS и кнопки Telegram.
PUBLIC_API_URL=http://localhost:3000
MINIAPP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Дополнительные источники для CORS через запятую. Нужно на staging, пока
# фронтенды доступны и по адресу хостинга, и по своему домену.
CORS_EXTRA_ORIGINS=

# ── Автоматический запуск (управляемый хостинг) ──────────────────────────────
# [демо] Контейнер сам накатывает миграции перед стартом. В docker compose
#        для этого есть отдельный сервис, поэтому там переменная не нужна.
RUN_MIGRATIONS_ON_BOOT=false
# [демо] Демо-данные при старте — только если база пуста.
SEED_DEMO_ON_EMPTY=false
# worker — процесс фоновых задач вместо API. Пусто — обычный API.
PROCESS_ROLE=

# ── База данных ──────────────────────────────────────────────────────────────
# [обяз.] PostgreSQL 16.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pdr_dev?schema=public

# ── Сессии ───────────────────────────────────────────────────────────────────
# [обяз.] Не короче 32 символов. Для staging и production сгенерируйте:
#         openssl rand -base64 48
SESSION_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# ── Демо-вход (staging) ──────────────────────────────────────────────────────
# [демо] Вход готовыми аккаунтами без Telegram: нужен, чтобы открыть приложение
#        в обычном браузере. В production включение запрещено проверкой конфига.
DEMO_LOGIN_ENABLED=false
# На staging обязателен секрет не короче 16 символов: он закрывает демо-вход
# от посторонних. Передаётся в ссылке ?demo=<секрет>.
DEMO_LOGIN_SECRET=

# ── Telegram ─────────────────────────────────────────────────────────────────
# [ключ] Токен бота от @BotFather. Без него работает только демо-вход.
TELEGRAM_BOT_TOKEN=
# [ключ] Имя бота без @ — из него собираются ссылки на Mini App и приглашения.
TELEGRAM_BOT_USERNAME=
# [обяз. при TELEGRAM_ENABLED] Любая случайная строка: ею подписывается webhook.
TELEGRAM_WEBHOOK_SECRET=
# [ключ] ID закрытой группы клуба (бот должен быть в ней администратором).
TELEGRAM_CLUB_CHAT_ID=
# [ключ] Постоянная ссылка-заявка в группу (creates_join_request=true).
TELEGRAM_CLUB_INVITE_LINK=
TELEGRAM_INITDATA_MAX_AGE_SEC=300
TELEGRAM_LOGIN_MAX_AGE_SEC=300
# true включает вход через Telegram и обработку вебхука.
TELEGRAM_ENABLED=false

# ── Файловое хранилище ───────────────────────────────────────────────────────
# STORAGE_DRIVER=s3 | local. local — разработка, тесты и демо-staging.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-local
# [ключ] S3-совместимое хранилище (Yandex Object Storage, MinIO, AWS).
S3_ENDPOINT=
S3_REGION=ru-central1
S3_BUCKET=pdr-local
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_UPLOAD_TTL_SEC=600
S3_PRESIGN_DOWNLOAD_TTL_SEC=300
FILE_MAX_SIZE_IMAGE=20971520
FILE_MAX_SIZE_VIDEO=524288000
FILE_MAX_SIZE_DOCUMENT=52428800
# Квота хранилища на мастерскую, мегабайты. 0 — без ограничения.
STORAGE_WORKSPACE_QUOTA_MB=20480

# ── Видео ────────────────────────────────────────────────────────────────────
# VIDEO_PROVIDER=kinescope | mock. mock отдаёт заглушку вместо плеера.
VIDEO_PROVIDER=mock
# [ключ] API-ключ Kinescope и идентификатор родительской папки.
KINESCOPE_API_KEY=
KINESCOPE_PARENT_ID=
# [ключ] Шаблон плеера с запретом скачивания. Необязателен.
KINESCOPE_PLAYER_TEMPLATE_ID=
# Жизнь сессии просмотра, секунды. Короткая намеренно: адрес плеера должен
# переставать работать быстро, продление стоит один запрос.
VIDEO_SESSION_TTL_SEC=300
# [обяз. при kinescope] Подпись токена просмотра, не короче 32 символов.
#   openssl rand -base64 48
VIDEO_TOKEN_SECRET=
# [ключ] Общий секрет, которым провайдер подписывает запросы проверки доступа.
VIDEO_AUTH_CALLBACK_SECRET=
# Общий рубильник DRM. Включать только после проверки на реальных устройствах:
# в Telegram WebView защищённое воспроизведение доступно не везде.
VIDEO_DRM_ENABLED=false
# Персональный водяной знак поверх видео.
VIDEO_WATERMARK_ENABLED=true

# ── AI-оценка повреждения по фотографии ──────────────────────────────────────
# disabled — способ выключен, и это рабочее состояние: обращения, схема кузова,
#            разметка снимков, ручная оценка и расчёт по прайсу от него не зависят.
# mock      — детерминированная заглушка для локальной разработки и демо.
#             В production запрещена: её разбор выглядел бы как настоящая оценка.
# openai_compatible — любой сервис с API вида Chat Completions (OpenAI, шлюзы,
#             совместимые отечественные сервисы). Смена модели — это две
#             переменные ниже, а не правка кода.
AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com/v1
# [ключ] [обяз. при openai_compatible]
AI_API_KEY=
# [обяз. при openai_compatible] Модель обязана понимать изображения.
AI_MODEL=
AI_TIMEOUT_MS=45000

# ── Наблюдаемость ────────────────────────────────────────────────────────────
# [ключ] DSN проекта Sentry. Пусто — ошибки только в логах.
SENTRY_DSN=
LOG_LEVEL=info

# ── Резервные копии ──────────────────────────────────────────────────────────
# [ключ] Bucket для дампов базы (отдельный от bucket'а файлов).
BACKUP_S3_BUCKET=
BACKUP_RETENTION_DAYS=30
