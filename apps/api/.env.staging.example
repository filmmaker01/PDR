# Демонстрационный staging: работает без внешних ключей.
# Скопируйте в apps/api/.env.staging и при необходимости поправьте адреса.
NODE_ENV=production
APP_ENV=staging
PORT=3000

PUBLIC_API_URL=http://localhost:3000
MINIAPP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pdr_staging?schema=public

# openssl rand -base64 48
SESSION_JWT_SECRET=staging-secret-change-me-staging-secret-change-me
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# Вход демо-аккаунтами вместо Telegram.
DEMO_LOGIN_ENABLED=true
DEMO_LOGIN_SECRET=staging-demo-secret-01

# Без ключей: Telegram выключен, видео — заглушка, файлы — на диске.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CLUB_CHAT_ID=
TELEGRAM_CLUB_INVITE_LINK=

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-staging
S3_BUCKET=pdr-staging
STORAGE_WORKSPACE_QUOTA_MB=20480

VIDEO_PROVIDER=mock

LOG_LEVEL=info
