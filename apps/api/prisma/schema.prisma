// Схема PDR Platform. Соответствует docs/03-database.md.
// Модели добавляются по этапам roadmap; каждая миграция обратно совместима.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, btree_gist]
}

// ── Служебное (этап 0) ────────────────────────────────────────────────────────

model WorkerHeartbeat {
  workerId   String   @id @map("worker_id")
  lastBeatAt DateTime @map("last_beat_at") @db.Timestamptz(6)
  version    String?

  @@map("worker_heartbeats")
}

// ── Пользователи, сессии, роли платформы (этап 1) ─────────────────────────────

enum PlatformRoleName {
  admin
  curator

  @@map("platform_role_name")
}

enum SessionKind {
  miniapp
  web

  @@map("session_kind")
}

enum WebLoginStatus {
  pending
  confirmed
  expired
  used

  @@map("web_login_status")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  telegramUserId BigInt    @unique @map("telegram_user_id")
  firstName      String    @map("first_name")
  lastName       String?   @map("last_name")
  username       String?
  languageCode   String?   @map("language_code")
  photoUrl       String?   @map("photo_url")
  phone          String?
  email          String?
  /// Бот не может писать пользователю (получен 403 от Telegram).
  isBotBlocked   Boolean   @default(false) @map("is_bot_blocked")
  /// Пользователь запустил бота или дал разрешение на сообщения.
  botWriteAllowed Boolean  @default(false) @map("bot_write_allowed")
  isBanned       Boolean   @default(false) @map("is_banned")
  banReason      String?   @map("ban_reason")
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions          Session[]
  platformRoles     PlatformRole[]  @relation("UserPlatformRoles")
  grantedRoles      PlatformRole[]  @relation("PlatformRoleGrantedBy")
  webLoginRequests  WebLoginRequest[]
  idempotencyKeys   IdempotencyKey[]
  workspaceMemberships WorkspaceMember[]
  createdWorkspaces    Workspace[]           @relation("WorkspaceCreatedBy")
  createdInvitations   WorkspaceInvitation[] @relation("InvitationCreatedBy")
  acceptedInvitations  WorkspaceInvitation[] @relation("InvitationAcceptedBy")
  accessGrants         AccessGrant[]         @relation("GrantSubjectUser")
  grantedAccess        AccessGrant[]         @relation("GrantGrantedBy")
  revokedAccess        AccessGrant[]         @relation("GrantRevokedBy")
  files                StoredFile[]          @relation("FileOwner")
  notifications        Notification[]
  notificationPreference NotificationPreference?
  auditEntries         AuditLog[]
  publishedVersions    CourseVersion[]       @relation("CourseVersionPublishedBy")
  uploadedVideos       VideoAsset[]          @relation("VideoUploadedBy")
  enrollments          Enrollment[]
  curatedCohorts       CohortCurator[]
  stageOverrides       StageOverride[]       @relation("StageOverrideCreatedBy")
  claimedSubmissions   Submission[]          @relation("SubmissionClaimedBy")
  reviews              Review[]              @relation("ReviewAuthor")
  reviewComments       ReviewComment[]       @relation("ReviewCommentAuthor")
  gradedAttempts       ExamAttempt[]         @relation("AttemptGrader")

  @@index([username])
  @@index([phone])
  @@map("users")
}

model Session {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  /// sha256 от непрозрачного refresh-токена: сам токен в базе не хранится.
  refreshTokenHash String      @unique @map("refresh_token_hash")
  kind             SessionKind
  userAgent        String?     @map("user_agent")
  ip               String?
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt       DateTime    @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt        DateTime    @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?   @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?     @map("revoke_reason")
  /// Цепочка ротации: позволяет распознать повторное использование старого токена.
  replacedById     String?     @unique @map("replaced_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PlatformRole {
  userId      String           @map("user_id") @db.Uuid
  role        PlatformRoleName
  grantedById String?          @map("granted_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User  @relation("UserPlatformRoles", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("PlatformRoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, role])
  @@map("platform_roles")
}

model WebLoginRequest {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique
  status      WebLoginStatus @default(pending)
  userId      String?        @map("user_id") @db.Uuid
  userAgent   String?        @map("user_agent")
  ip          String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz(6)
  confirmedAt DateTime?      @map("confirmed_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@map("web_login_requests")
}

model IdempotencyKey {
  key            String   @db.VarChar(200)
  userId         String   @map("user_id") @db.Uuid
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// Обработанные обновления Telegram: защита от повторной доставки webhook.
model TelegramUpdate {
  updateId  BigInt   @id @map("update_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("telegram_updates")
}

// ── Мастерские и участники (этап 2) ──────────────────────────────────────────

enum WorkspaceRole {
  owner
  employee

  @@map("workspace_role")
}

model Workspace {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  /// Часовой пояс IANA: определяет «сегодня» и отображение календаря.
  timezone   String    @default("Europe/Moscow")
  currency   String    @default("RUB") @db.Char(3)
  phone      String?
  address    String?
  /// Рабочие часы, длительность записи по умолчанию, права сотрудников.
  settings   Json      @default("{}")
  /// Счётчик номеров заказов внутри мастерской.
  orderSeq   Int       @default(0) @map("order_seq")
  createdById String?  @map("created_by") @db.Uuid
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy   User?                  @relation("WorkspaceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  grants      AccessGrant[]
  files       StoredFile[]
  auditEntries AuditLog[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  displayName String?       @map("display_name")
  /// Цвет исполнителя в календаре.
  color       String?
  isActive    Boolean       @default(true) @map("is_active")
  joinedAt    DateTime      @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt      DateTime?     @map("left_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@unique([workspaceId, id], name: "member_in_workspace")
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  role         WorkspaceRole
  /// sha256 от токена приглашения: сам токен есть только в ссылке.
  tokenHash    String        @unique @map("token_hash")
  /// Необязательное ограничение: принять может только этот номер.
  invitedPhone String?       @map("invited_phone")
  note         String?
  createdById  String        @map("created_by") @db.Uuid
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(6)
  acceptedById String?       @map("accepted_by") @db.Uuid
  acceptedAt   DateTime?     @map("accepted_at") @db.Timestamptz(6)
  revokedAt    DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy User?     @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("workspace_invitations")
}

// ── Продуктовые доступы (этап 2) ─────────────────────────────────────────────

enum Product {
  course
  crm
  club

  @@map("product")
}

enum GrantSubject {
  user
  workspace

  @@map("grant_subject")
}

enum GrantStatus {
  active
  expired
  revoked
  suspended

  @@map("grant_status")
}

enum GrantSource {
  manual
  promo
  migration
  payment

  @@map("grant_source")
}

model AccessGrant {
  id          String       @id @default(uuid()) @db.Uuid
  product     Product
  subjectType GrantSubject @map("subject_type")
  userId      String?      @map("user_id") @db.Uuid
  workspaceId String?      @map("workspace_id") @db.Uuid
  /// Для product=course: к какому курсу относится доступ.
  courseId    String?      @map("course_id") @db.Uuid
  status      GrantStatus  @default(active)
  validFrom   DateTime     @default(now()) @map("valid_from") @db.Timestamptz(6)
  /// null = бессрочный доступ.
  validUntil  DateTime?    @map("valid_until") @db.Timestamptz(6)
  source      GrantSource  @default(manual)
  externalRef String?      @map("external_ref")
  reason      String?
  grantedById String?      @map("granted_by") @db.Uuid
  revokedById String?      @map("revoked_by") @db.Uuid
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User?      @relation("GrantSubjectUser", fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grantedBy User?      @relation("GrantGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy User?      @relation("GrantRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, product, status])
  @@index([workspaceId, product, status])
  @@index([validUntil])
  /// Самый частый запрос guard'а: действующий доступ по продукту.
  @@index([product, status, validUntil])
  @@map("access_grants")
}

// ── Файлы (этап 3) ───────────────────────────────────────────────────────────

enum FileScope {
  order_photo
  submission
  exam_attempt
  lesson_material
  avatar
  export
  course_cover
  question_image

  @@map("file_scope")
}

enum FileStatus {
  pending
  uploaded
  processing
  ready
  failed
  deleted

  @@map("file_status")
}

model StoredFile {
  id           String     @id @default(uuid()) @db.Uuid
  ownerUserId  String     @map("owner_user_id") @db.Uuid
  /// Для файлов CRM: мастерская-владелец. Для учебных — null.
  workspaceId  String?    @map("workspace_id") @db.Uuid
  scope        FileScope
  /// Ключ объекта в хранилище: <scope>/<владелец>/<год>/<месяц>/<id>.<ext>
  storageKey   String     @unique @map("storage_key")
  bucket       String
  mimeType     String     @map("mime_type")
  sizeBytes    BigInt     @map("size_bytes")
  originalName String?    @map("original_name")
  status       FileStatus @default(pending)
  width        Int?
  height       Int?
  durationSec  Int?       @map("duration_sec")
  /// Производные: {"thumb":"<key>","preview":"<key>"}
  variants     Json       @default("{}")
  checksumSha256 String?  @map("checksum_sha256")
  /// Незавершённая многочастная загрузка.
  uploadId     String?    @map("upload_id")
  error        String?
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  owner     User       @relation("FileOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stageCovers      Stage[]          @relation("StageCover")
  lessonMaterials  LessonMaterial[] @relation("LessonMaterialFile")
  questionImages   Question[]       @relation("QuestionImage")
  submissionFiles  SubmissionFile[] @relation("SubmissionFiles")
  attemptFiles     AttemptFile[]    @relation("AttemptFiles")

  @@index([workspaceId, scope])
  @@index([ownerUserId, scope])
  @@index([status, createdAt])
  @@map("files")
}

// ── Уведомления и аудит (этап 4) ─────────────────────────────────────────────

enum NotificationStatus {
  queued
  sent
  failed
  skipped

  @@map("notification_status")
}

model NotificationPreference {
  userId               String   @id @map("user_id") @db.Uuid
  reviewResults        Boolean  @default(true) @map("review_results")
  stageUnlocked        Boolean  @default(true) @map("stage_unlocked")
  appointmentReminders Boolean  @default(true) @map("appointment_reminders")
  orderAssigned        Boolean  @default(true) @map("order_assigned")
  accessExpiring       Boolean  @default(true) @map("access_expiring")
  reviewQueueDigest    Boolean  @default(true) @map("review_queue_digest")
  /// За сколько минут напоминать о записи.
  reminderLeadMinutes  Int      @default(60) @map("reminder_lead_minutes")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Notification {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  type              String
  payload           Json               @default("{}")
  /// Защита от повторной отправки одного и того же события.
  dedupeKey         String?            @unique @map("dedupe_key")
  status            NotificationStatus @default(queued)
  telegramMessageId BigInt?            @map("telegram_message_id")
  error             String?
  attempts          Int                @default(0)
  scheduledAt       DateTime           @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, scheduledAt])
  @@map("notifications")
}

model AuditLog {
  id              BigInt   @id @default(autoincrement())
  requestId       String?  @map("request_id")
  /// null — действие выполнено системой или фоновой задачей.
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  actorRoleContext String? @map("actor_role_context")
  workspaceId     String?  @map("workspace_id") @db.Uuid
  entityType      String   @map("entity_type")
  entityId        String?  @map("entity_id")
  action          String
  before          Json?
  after           Json?
  ip              String?
  userAgent       String?  @map("user_agent")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor     User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

// ── Курс: структура и версии (этап 5) ────────────────────────────────────────

enum CourseVersionStatus {
  draft
  published
  archived

  @@map("course_version_status")
}

enum MaterialKind {
  file
  link
  text

  @@map("material_kind")
}

enum VideoStatus {
  uploading
  processing
  ready
  failed

  @@map("video_status")
}

enum ExamKind {
  test
  practical

  @@map("exam_kind")
}

enum QuestionKind {
  single
  multiple
  boolean
  short_text

  @@map("question_kind")
}

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions CourseVersion[]
  cohorts  Cohort[]

  @@map("courses")
}

/// Опубликованная версия неизменяема: правка курса не ломает прогресс групп.
model CourseVersion {
  id            String              @id @default(uuid()) @db.Uuid
  courseId      String              @map("course_id") @db.Uuid
  versionNo     Int                 @map("version_no")
  status        CourseVersionStatus @default(draft)
  changelog     String?
  publishedAt   DateTime?           @map("published_at") @db.Timestamptz(6)
  publishedById String?             @map("published_by") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  publishedBy User?     @relation("CourseVersionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  stages      Stage[]
  cohorts     Cohort[]

  @@unique([courseId, versionNo])
  @@map("course_versions")
}

model Stage {
  id              String  @id @default(uuid()) @db.Uuid
  courseVersionId String  @map("course_version_id") @db.Uuid
  /// Стабильный ключ между версиями: по нему переносится прогресс.
  key             String
  position        Int
  title           String
  description     String?
  coverFileId     String? @map("cover_file_id") @db.Uuid
  /// Дней от старта обучения ученика (режим interval).
  unlockDaysOffset Int    @default(0) @map("unlock_days_offset")
  requiresPreviousStage Boolean @default(true) @map("requires_previous_stage")

  courseVersion CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  coverFile     StoredFile?   @relation("StageCover", fields: [coverFileId], references: [id], onDelete: SetNull)
  lessons       Lesson[]
  assignments   Assignment[]
  exams         Exam[]

  @@unique([courseVersionId, key])
  @@unique([courseVersionId, position])
  @@map("stages")
}

model Lesson {
  id              String  @id @default(uuid()) @db.Uuid
  stageId         String  @map("stage_id") @db.Uuid
  key             String
  position        Int
  title           String
  description     String?
  isRequired      Boolean @default(true) @map("is_required")
  videoAssetId    String? @map("video_asset_id") @db.Uuid
  /// Вспомогательный порог просмотра. 0 — не учитывается.
  minWatchPercent Int     @default(0) @map("min_watch_percent")
  estimatedMinutes Int?   @map("estimated_minutes")

  stage      Stage            @relation(fields: [stageId], references: [id], onDelete: Cascade)
  videoAsset VideoAsset?      @relation(fields: [videoAssetId], references: [id], onDelete: SetNull)
  materials  LessonMaterial[]
  assignments Assignment[]

  @@unique([stageId, key])
  @@unique([stageId, position])
  @@map("lessons")
}

model LessonMaterial {
  id       String       @id @default(uuid()) @db.Uuid
  lessonId String       @map("lesson_id") @db.Uuid
  position Int
  kind     MaterialKind
  title    String
  fileId   String?      @map("file_id") @db.Uuid
  url      String?
  body     String?

  lesson Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  file   StoredFile? @relation("LessonMaterialFile", fields: [fileId], references: [id], onDelete: SetNull)

  @@unique([lessonId, position])
  @@map("lesson_materials")
}

/// Ссылка на видео во внешней платформе (Kinescope).
model VideoAsset {
  id              String      @id @default(uuid()) @db.Uuid
  provider        String
  providerVideoId String      @map("provider_video_id")
  title           String
  durationSec     Int?        @map("duration_sec")
  status          VideoStatus @default(uploading)
  uploadedById    String?     @map("uploaded_by") @db.Uuid
  error           String?
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  uploadedBy User?    @relation("VideoUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  lessons    Lesson[]

  @@unique([provider, providerVideoId])
  @@map("video_assets")
}

model Assignment {
  id           String  @id @default(uuid()) @db.Uuid
  stageId      String  @map("stage_id") @db.Uuid
  /// Задание к уроку или к этапу в целом.
  lessonId     String? @map("lesson_id") @db.Uuid
  key          String
  position     Int
  title        String
  instructions String
  isRequired   Boolean @default(true) @map("is_required")
  /// {"min_photos":1,"min_videos":0,"text_required":false}
  requiredMedia Json   @default("{\"min_photos\":1,\"min_videos\":0,\"text_required\":false}") @map("required_media")
  maxVideoSec  Int?    @map("max_video_sec")

  stage  Stage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@unique([stageId, key])
  @@map("assignments")
}

model Exam {
  id                  String   @id @default(uuid()) @db.Uuid
  stageId             String   @map("stage_id") @db.Uuid
  key                 String
  position            Int
  title               String
  kind                ExamKind
  description         String?
  /// Проценты для теста; порог оценки куратора для практики.
  passingScore        Int      @map("passing_score")
  maxAttempts         Int?     @map("max_attempts")
  timeLimitSec        Int?     @map("time_limit_sec")
  cooldownHours       Int      @default(0) @map("cooldown_hours")
  shuffleQuestions    Boolean  @default(true) @map("shuffle_questions")
  questionsPerAttempt Int?     @map("questions_per_attempt")
  showExplanations    Boolean  @default(true) @map("show_explanations")
  isRequired          Boolean  @default(true) @map("is_required")

  stage     Stage         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  ExamAttempt[]

  @@unique([stageId, key])
  @@map("exams")
}

model Question {
  id           String       @id @default(uuid()) @db.Uuid
  examId       String       @map("exam_id") @db.Uuid
  position     Int
  kind         QuestionKind
  body         String
  imageFileId  String?      @map("image_file_id") @db.Uuid
  explanation  String?
  points       Int          @default(1)
  /// Принимаемые ответы для короткого текста.
  acceptedAnswers Json?     @map("accepted_answers")

  exam      Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  imageFile StoredFile?      @relation("QuestionImage", fields: [imageFileId], references: [id], onDelete: SetNull)
  options   QuestionOption[]
  answers   AttemptAnswer[]

  @@unique([examId, position])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  position   Int
  body       String
  isCorrect  Boolean @map("is_correct")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@map("question_options")
}

// ── Группы, зачисления, прогресс (этап 6) ────────────────────────────────────

enum UnlockMode {
  /// Дни от индивидуального старта ученика (режим по умолчанию).
  interval
  /// Даты группы: для потоков, когда все идут вместе.
  dates

  @@map("unlock_mode")
}

enum EnrollmentStatus {
  active
  completed
  paused
  withdrawn

  @@map("enrollment_status")
}

enum OverrideAction {
  unlock
  lock

  @@map("override_action")
}

model Cohort {
  id              String     @id @default(uuid()) @db.Uuid
  courseId        String     @map("course_id") @db.Uuid
  /// Только опубликованная версия.
  courseVersionId String     @map("course_version_id") @db.Uuid
  title           String
  unlockMode      UnlockMode @default(interval) @map("unlock_mode")
  startsAt        DateTime   @map("starts_at") @db.Timestamptz(6)
  /// Для режима dates: {"stage-2":"2026-12-01T00:00:00Z"}
  stageDates      Json?      @map("stage_dates")
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseVersion CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Restrict)
  curators      CohortCurator[]
  enrollments   Enrollment[]

  @@index([courseId])
  @@map("cohorts")
}

model CohortCurator {
  cohortId  String   @map("cohort_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cohortId, userId])
  @@index([userId])
  @@map("cohort_curators")
}

model Enrollment {
  id            String           @id @default(uuid()) @db.Uuid
  cohortId      String           @map("cohort_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  accessGrantId String           @map("access_grant_id") @db.Uuid
  /// Индивидуальный старт обучения: от него считаются сроки этапов.
  startedAt     DateTime         @map("started_at") @db.Timestamptz(6)
  status        EnrollmentStatus @default(active)
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz(6)
  note          String?
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  cohort           Cohort            @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonProgress   LessonProgress[]
  submissions      Submission[]
  examAttempts     ExamAttempt[]
  stageOverrides   StageOverride[]
  stageCompletions StageCompletion[]

  @@unique([cohortId, userId])
  @@index([userId])
  @@map("enrollments")
}

model LessonProgress {
  id               String    @id @default(uuid()) @db.Uuid
  enrollmentId     String    @map("enrollment_id") @db.Uuid
  /// Ключ урока, а не идентификатор: прогресс переживает смену версии.
  lessonKey        String    @map("lesson_key")
  watchPositionSec Int       @default(0) @map("watch_position_sec")
  /// Максимально достигнутый процент просмотра.
  watchPercent     Int       @default(0) @map("watch_percent")
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  firstOpenedAt    DateTime? @map("first_opened_at") @db.Timestamptz(6)
  lastOpenedAt     DateTime? @map("last_opened_at") @db.Timestamptz(6)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonKey])
  @@map("lesson_progress")
}

/// Ручное открытие или закрытие этапа администратором. Приоритет выше правил.
model StageOverride {
  id           String         @id @default(uuid()) @db.Uuid
  enrollmentId String         @map("enrollment_id") @db.Uuid
  stageKey     String         @map("stage_key")
  action       OverrideAction
  reason       String
  createdById  String         @map("created_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime?      @map("expires_at") @db.Timestamptz(6)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("StageOverrideCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([enrollmentId, stageKey])
  @@map("stage_overrides")
}

/// Материализованный факт завершения этапа: пересчитывается сервисом прогресса.
model StageCompletion {
  enrollmentId String   @map("enrollment_id") @db.Uuid
  stageKey     String   @map("stage_key")
  completedAt  DateTime @map("completed_at") @db.Timestamptz(6)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@id([enrollmentId, stageKey])
  @@map("stage_completions")
}

// ── Практика: сдачи и проверки (этап 7) ──────────────────────────────────────

enum SubmissionStatus {
  draft
  submitted
  in_review
  accepted
  returned

  @@map("submission_status")
}

enum ReviewDecision {
  accepted
  returned

  @@map("review_decision")
}

model Submission {
  id            String           @id @default(uuid()) @db.Uuid
  enrollmentId  String           @map("enrollment_id") @db.Uuid
  /// Ключ задания: переживает смену версии курса.
  assignmentKey String           @map("assignment_key")
  attemptNo     Int              @map("attempt_no")
  status        SubmissionStatus @default(draft)
  text          String?
  submittedAt   DateTime?        @map("submitted_at") @db.Timestamptz(6)
  reviewedAt    DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  /// Кто взял работу на проверку и когда: удержание снимается по таймауту.
  claimedById   String?          @map("claimed_by") @db.Uuid
  claimedAt     DateTime?        @map("claimed_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  claimedBy  User?            @relation("SubmissionClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  files      SubmissionFile[]
  reviews    Review[]
  comments   ReviewComment[]

  @@unique([enrollmentId, assignmentKey, attemptNo])
  @@index([status, submittedAt])
  @@index([enrollmentId, assignmentKey])
  @@map("submissions")
}

model SubmissionFile {
  submissionId String @map("submission_id") @db.Uuid
  fileId       String @map("file_id") @db.Uuid
  position     Int

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  file       StoredFile @relation("SubmissionFiles", fields: [fileId], references: [id], onDelete: Cascade)

  @@id([submissionId, fileId])
  @@map("submission_files")
}

model Review {
  id           String         @id @default(uuid()) @db.Uuid
  submissionId String         @map("submission_id") @db.Uuid
  reviewerId   String         @map("reviewer_id") @db.Uuid
  decision     ReviewDecision
  comment      String
  /// Необязательные критерии оценки: {"light":4,"tool":5}
  rubric       Json?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User       @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("reviews")
}

/// Переписка по работе: уточняющие вопросы куратора и ответы ученика.
model ReviewComment {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  body         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User       @relation("ReviewCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
  @@map("review_comments")
}

// ── Экзамены: попытки и ответы (этап 8) ──────────────────────────────────────

enum AttemptStatus {
  in_progress
  submitted
  graded
  expired
  cancelled

  @@map("attempt_status")
}

model ExamAttempt {
  id           String        @id @default(uuid()) @db.Uuid
  enrollmentId String        @map("enrollment_id") @db.Uuid
  /// Ключ экзамена: переживает смену версии курса.
  examKey      String        @map("exam_key")
  /// Конкретная версия экзамена, по которой шла попытка.
  examId       String        @map("exam_id") @db.Uuid
  attemptNo    Int           @map("attempt_no")
  status       AttemptStatus @default(in_progress)
  startedAt    DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  deadlineAt   DateTime?     @map("deadline_at") @db.Timestamptz(6)
  submittedAt  DateTime?     @map("submitted_at") @db.Timestamptz(6)
  gradedAt     DateTime?     @map("graded_at") @db.Timestamptz(6)
  score        Int?
  maxScore     Int?          @map("max_score")
  percent      Int?
  passed       Boolean?
  graderId     String?       @map("grader_id") @db.Uuid
  graderComment String?      @map("grader_comment")
  /// Зафиксированные порядок и выборка вопросов для этой попытки.
  questionOrder Json?        @map("question_order")
  cancelReason String?       @map("cancel_reason")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  exam       Exam            @relation(fields: [examId], references: [id], onDelete: Restrict)
  grader     User?           @relation("AttemptGrader", fields: [graderId], references: [id], onDelete: SetNull)
  answers    AttemptAnswer[]
  files      AttemptFile[]

  @@unique([enrollmentId, examKey, attemptNo])
  @@index([enrollmentId, examKey])
  @@index([status, deadlineAt])
  @@map("exam_attempts")
}

model AttemptAnswer {
  id                String   @id @default(uuid()) @db.Uuid
  attemptId         String   @map("attempt_id") @db.Uuid
  questionId        String   @map("question_id") @db.Uuid
  selectedOptionIds String[] @map("selected_option_ids") @db.Uuid
  textAnswer        String?  @map("text_answer")
  isCorrect         Boolean? @map("is_correct")
  pointsAwarded     Int?     @map("points_awarded")
  answeredAt        DateTime @default(now()) @map("answered_at") @db.Timestamptz(6)

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}

model AttemptFile {
  attemptId String @map("attempt_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid
  position  Int

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  file    StoredFile  @relation("AttemptFiles", fields: [fileId], references: [id], onDelete: Cascade)

  @@id([attemptId, fileId])
  @@map("attempt_files")
}
